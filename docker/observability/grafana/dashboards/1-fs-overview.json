    {
      "type": "row",
      "title": "Recent errors (Loki)",
      "collapsed": false,
      "panels": [],
      "id": 17,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "logs",
      "title": "Application WARN / ERROR logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"app.*\", level=~\"WARN|ERROR\"} != \"SpringDoc\" | json | line_format \"{{.level}} [{{.service}}] {{.logger_name}} \u2014 {{.message}}\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "prettifyLogMessage": false
      },
      "id": 18,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 10
      }
    }
