{
  "uid": "fs-flashsale",
  "title": "FlashSale \u00b7 2. Flash sale live",
  "description": "Purchases, Redis gate efficiency and live slot state",
  "tags": [
    "flashsale"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "editable": true,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Purchases",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Purchases OK / min",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(flashsale_purchase_total{result=\"success\"}[1m])) * 60",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Rejected / min",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(flashsale_purchase_total{result!~\"success|replay\"}[1m])) * 60",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Purchase p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(flashsale_purchase_duration_seconds_bucket[5m])))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Rejected by Redis gate",
      "description": "Share of purchase attempts rejected in Redis without touching the database",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(flashsale_gate_total{result=~\"sold_out|already_purchased\"}[5m])) / clamp_min(sum(rate(flashsale_gate_total[5m])), 1e-9)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Gate bypassed (Redis down)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(flashsale_gate_total{result=\"bypassed\"}[5m])) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Oversold items (must be 0)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Live DB check: items with sold > quota (impossible by CHECK constraint)",
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS oversold FROM flash_sale_items WHERE sold > quota"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 7,
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Purchase attempts / s by result",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(flashsale_purchase_total[1m]))",
          "legendFormat": "{{result}}",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Redis gate decisions / s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(flashsale_gate_total[1m]))",
          "legendFormat": "{{result}}",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Purchase latency by result (click a dot = trace)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, result) (rate(flashsale_purchase_duration_seconds_bucket[1m])))",
          "legendFormat": "p95 {{result}}",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Live slots (PostgreSQL)",
      "collapsed": false,
      "panels": [],
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Items on sale right now",
      "description": "Live from the database \u2014 sold never exceeds quota (DB constraint)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT s.region, s.name AS slot, p.sku, p.name AS product, i.sale_price, i.quota, i.sold, i.quota - i.sold AS remaining,\n       round(100.0 * i.sold / NULLIF(i.quota, 0), 1) AS sold_pct\nFROM flash_sale_items i\nJOIN flash_sale_sessions s ON s.id = i.session_id\nJOIN products p ON p.id = i.product_id\nWHERE now() >= s.start_at AND now() < s.end_at AND i.status = 'APPROVED'\nORDER BY s.region, s.start_at, i.id",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 7
      }
    },
    {
      "type": "table",
      "title": "Orders per slot today (VN)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT s.name AS slot, count(o.id) AS orders, COALESCE(sum(o.amount), 0) AS revenue\nFROM flash_sale_sessions s\nLEFT JOIN flash_sale_items i ON i.session_id = s.id\nLEFT JOIN orders o ON o.flash_sale_item_id = i.id\nWHERE s.region = 'VN' AND s.sale_date = (now() AT TIME ZONE 'Asia/Ho_Chi_Minh')::date\nGROUP BY s.name, s.start_at ORDER BY s.start_at",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true
      },
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Purchase logs (Loki)",
      "collapsed": false,
      "panels": [],
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "logs",
      "title": "Purchases (open a line \u2192 traceId \u2192 trace)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"app.*\"} |= \"Flash sale purchase\" | json | line_format \"[{{.service}}] {{.message}}\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "prettifyLogMessage": false
      },
      "id": 15,
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 8
      }
    }
  ],
