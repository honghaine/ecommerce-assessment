      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(outbox_events_processed_total[1m]))",
          "legendFormat": "{{type}}",
          "exemplar": true
        },
        {
          "refId": "B",
          "expr": "sum by (type) (rate(outbox_events_failed_total[1m]))",
          "legendFormat": "FAILED {{type}}",
          "exemplar": true
