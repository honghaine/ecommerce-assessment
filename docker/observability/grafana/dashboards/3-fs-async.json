    {
      "type": "table",
      "title": "Stock per product",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT p.region, p.sku, p.name, p.status, v.total, v.available, v.reserved, v.updated_at\nFROM inventory v JOIN products p ON p.id = v.product_id ORDER BY p.region, p.id",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true
      },
      "id": 12,
      "gridPos": {
