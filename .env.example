# Copy to .env and adjust. Defaults work out of the box for local Docker.

# PostgreSQL
DB_NAME=flashsale
DB_USER=flashsale
DB_PASSWORD=flashsale
DB_POOL_SIZE=30

# Redis
REDIS_PASSWORD=

# Security (dev-only defaults — always override outside local)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
OTP_SECRET=dev-only-otp-secret-change-me-0123456789abcdef

# Mock notifications: log OTP content (dev only)
NOTIFICATION_MOCK_LOG_CONTENT=true

# Store OTP unhashed in Redis, key otp:register:<email|phone> (dev only)
OTP_PLAIN_STORAGE=true

# Demo data: accounts (password below), products, flash-sale slots for today/tomorrow
SEED_ENABLED=true
SEED_PASSWORD=Secret123
SEED_BUYERS=200

# Demo balance for new buyer wallets
WALLET_INITIAL_BALANCE=1000000

# Outbox poller
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100

# Host ports
APP_PORT=8080
DB_PORT_HOST=5432
REDIS_PORT_HOST=6379

# Warehouse (WMS) integration key for POST /api/v1/integrations/warehouse/stock-events (empty = disabled)
WAREHOUSE_API_KEY=change-me-to-a-long-random-value

# Observability (docker compose --profile observability): export traces to Tempo
TRACING_ENABLED=false
GRAFANA_ADMIN_PASSWORD=admin
